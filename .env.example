# Quote form endpoint. With Formspree: create a form at https://formspree.io, then paste its
# endpoint, e.g. https://formspree.io/f/abcdwxyz — submissions are emailed to you.
# Leave empty to use the mock submission (shows success, sends nothing).
VITE_QUOTE_API_URL=

# Optional: a second form for the footer newsletter box (can be the same service).
VITE_NEWSLETTER_API_URL=
